import React from 'react';

interface TimeRingProps {
  progress?: number; // 0 to 1
  color?: string;
  glow?: string;
  children: React.ReactNode;
  size?: number;
}

export const TimeRing: React.FC<TimeRingProps> = ({
  progress = 1,
  color = 'var(--ph-accent)',
  glow,
  children,
  size = 280,
}) => {
  const strokeWidth = 2.5;
  const radius = 115;
  const circumference = 2 * Math.PI * radius;
  const strokeDashoffset = circumference - progress * circumference;

  return (
    <div
      className="ph-hud"
      style={{
        position: 'relative',
        width: '100%',
        maxWidth: size,
        aspectRatio: '1',
        margin: '0 auto',
        display: 'flex',
        alignItems: 'center',
        justifyContent: 'center',
      }}
    >
      {/* 4 HUD Corners */}
      <span className="ph-hud__corner" />
      <span className="ph-hud__corner" />
      <span className="ph-hud__corner" />
      <span className="ph-hud__corner" />

      {/* SVG Ring */}
      <svg
        viewBox="0 0 260 260"
        style={{
          position: 'absolute',
          inset: 0,
          width: '100%',
          height: '100%',
          transform: 'rotate(-90deg)',
        }}
      >
        {/* Track circle */}
        <circle
          cx="130"
          cy="130"
          r={radius}
          fill="none"
          stroke="var(--ph-surface-4)"
          strokeWidth={strokeWidth}
          strokeDasharray="4 6"
        />
        {/* Progress circle */}
        <circle
          cx="130"
          cy="130"
          r={radius}
          fill="none"
          stroke={color}
          strokeWidth={strokeWidth + 1}
          strokeDasharray={circumference}
          strokeDashoffset={strokeDashoffset}
          strokeLinecap="round"
          style={{
            filter: glow ? `drop-shadow(0 0 12px ${glow})` : undefined,
            transition: 'stroke-dashoffset 0.6s ease',
          }}
        />
      </svg>

      {/* Inner Content */}
      <div
        style={{
          position: 'relative',
          zIndex: 1,
          display: 'flex',
          flexDirection: 'column',
          alignItems: 'center',
          justifyContent: 'center',
          textAlign: 'center',
          gap: 6,
          padding: 20,
        }}
      >
        {children}
      </div>
    </div>
  );
};
